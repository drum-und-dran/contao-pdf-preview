{
    "name": "dud/contao-pdf-preview",
    "description": "PDF-Dateien als responsive Bilder in News, Events und allen Inhaltselementen mit Bildauswahl – mit Seitenauswahl, wichtigem Bereich, Sicherheitsprüfung und Virenscan.",
    "keywords": [
        "contao",
        "pdf",
        "preview",
        "image",
        "thumbnail",
        "news",
        "events",
        "responsive"
    ],
    "type": "contao-bundle",
    "homepage": "https://drum-und-dran.de",
    "license": "MIT",
    "authors": [
        {
            "name": "Gunnar Haeuschkel / Drum und Dran",
            "homepage": "https://drum-und-dran.de"
        }
    ],
    "support": {
        "issues": "https://github.com/drum-und-dran/contao-pdf-preview/issues",
        "source": "https://github.com/drum-und-dran/contao-pdf-preview"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/drum-und-dran"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^5.3 || ^6.0",
        "contao/image": "^1.2",
        "doctrine/dbal": "^3.6 || ^4.0",
        "imagine/imagine": "^1.3",
        "psr/cache": "^1.0 || ^2.0 || ^3.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/config": "^6.4 || ^7.4 || ^8.0",
        "symfony/console": "^6.4 || ^7.4 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.0",
        "symfony/filesystem": "^6.4 || ^7.4 || ^8.0",
        "symfony/finder": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.0",
        "symfony/process": "^6.4 || ^7.4 || ^8.0",
        "symfony/routing": "^6.4 || ^7.4 || ^8.0",
        "symfony/security-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/security-csrf": "^6.4 || ^7.4 || ^8.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.3",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Dud\\ContaoPdfPreview\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dud\\ContaoPdfPreview\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Dud\\ContaoPdfPreview\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "contao/manager-plugin": true,
            "php-http/discovery": true
        },
        "sort-packages": true
    }
}
